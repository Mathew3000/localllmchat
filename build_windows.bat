@echo off
setlocal enabledelayedexpansion

echo ================================================
echo  LocalLLMChat - Windows local build
echo ================================================
echo.

:: Optional: stamp a version. Usage: build_windows.bat 1.4.0
set VERSION=%~1
if not "%VERSION%"=="" (
    echo Stamping version: v%VERSION%
    echo /// Auto-generated by local build script. Do not edit by hand.> lib\version.dart
    echo const String kAppVersion = 'v%VERSION% (local)';>> lib\version.dart
    echo.
)

echo Fetching dependencies...
flutter pub get
if errorlevel 1 goto :error

echo.
echo Building release...
if not "%VERSION%"=="" (
    flutter build windows --release --build-name="%VERSION%" --build-number=0
) else (
    flutter build windows --release
)
if errorlevel 1 goto :error

echo.
echo ================================================
echo  Build complete!
echo  Output: build\windows\x64\runner\Release\
echo ================================================
goto :end

:error
echo.
echo Build failed.
exit /b 1

:end
endlocal
