@echo off
setlocal

echo ================================================
echo  LocalLLMChat - Windows local build
echo ================================================
echo.

set VERSION=%~1
if "%VERSION%"=="" goto :build

echo Stamping version: v%VERSION%
(
  echo /// Auto-generated by local build script. Do not edit by hand.
  echo const String kAppVersion = 'v%VERSION% ^(local^)';
) > lib\version.dart
echo.

:build
echo Fetching dependencies...
flutter pub get
if errorlevel 1 goto :error

echo.
echo Building release...
if "%VERSION%"=="" (
    flutter build windows --release
) else (
    flutter build windows --release --build-name="%VERSION%" --build-number=0
)
if errorlevel 1 goto :error

echo.
echo ================================================
echo  Build complete!
echo  Output: build\windows\x64\runner\Release\
echo ================================================
goto :end

:error
echo.
echo Build failed.
exit /b 1

:end
endlocal
