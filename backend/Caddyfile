# LocalLLMChat backend — TLS with self-signed or user-supplied certs.
# Cert files are mounted from ../certs/ (relative to the repo root).
#
# To use Let's Encrypt instead (public domain):
#   Replace ":443" with your domain, remove the tls directive,
#   and Caddy will obtain a cert automatically.

:443 {
    tls /etc/certs/server.crt /etc/certs/server.key

    # WebSocket — streaming generation
    @ws { path /ws }
    reverse_proxy @ws backend:8080

    # REST API + health check
    reverse_proxy /api/* backend:8080
    reverse_proxy /health backend:8080
}
