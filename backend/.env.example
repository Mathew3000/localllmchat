# Copy this file to .env and fill in the values before running docker compose.
# Generate a strong secret with: openssl rand -hex 32

SECRET_KEY=change-me-to-a-long-random-hex-string
DATABASE_URL=sqlite+aiosqlite:////data/db.sqlite
# Access token lifetime in minutes (default: 30).
# Clients auto-renew via the 30-day refresh token, so short lifetimes are safe.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated browser origins allowed for CORS (leave empty for mobile-only).
# Example: CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# In-app updates for the Android app (leave UPDATE_GITHUB_REPO empty to disable).
# The server downloads the newest GitHub Release and passes it to signed-in users.
UPDATE_GITHUB_REPO=Mathew3000/localllmchat
# Fine-grained token with read-only "Contents" access to that repo
# (only needed while the repo is private).
UPDATE_GITHUB_TOKEN=
